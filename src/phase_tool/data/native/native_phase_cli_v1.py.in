"""Stdlib-only caller for one accepted fixed native Phase installation.

Usage: accepted-python -I -S -B -u cli.py execute|inspect|publish-bundle|publish-input|publish-file|recover-publication|continue-version REQUEST_JSON|- NEW_CAPTURE_DIR
Install beside the accepted launcher.py and native-phase.json. Requests use the
existing {run_id,request} envelope and prepared execute or unary known-run inspect.
Operational delivery captures are separate from Core receipts and evidence.
No retry, installation, SDK bridge or worker termination is performed. Outer
process exit and pipe closure cannot establish native worker quiescence.
"""
import base64,errno,hashlib,json,os,re,stat,subprocess,sys,time
from pathlib import Path

MAX_REQUEST=2*1024**2
MAX_STDOUT=2*1024**2+10
MAX_STDERR=512*1024
MAX_DELIVERY=64*1024
DELIVERY_DIAGNOSTIC_PREFIX=4*1024
HERE=Path(__file__).absolute().parent
_PENDING_DELIVERY_OWNERS=[]  # Process-local only; never a durable operation owner.

def need(value,message):
    if not value:raise RuntimeError(message)
def canon(value):return json.dumps(value,ensure_ascii=False,sort_keys=True,separators=(',',':'),allow_nan=False).encode('utf-8')
def sha(raw):return 'sha256:'+hashlib.sha256(raw).hexdigest()
def strict(raw):
    def pairs(items):
        out={}
        for key,value in items:
            need(key not in out,'duplicate JSON member');out[key]=value
        return out
    def forbidden(value):raise RuntimeError('noninteger/nonfinite JSON number: '+value)
    return json.loads(raw,object_pairs_hook=pairs,parse_float=forbidden,parse_constant=forbidden)

def ordinary(path,maximum):
    path=path.absolute()
    for part in (*reversed(path.parents),path):
        info=part.lstat()
        need(not stat.S_ISLNK(info.st_mode)and not getattr(info,'st_file_attributes',0)&0x400,'reparse/symlink path')
    info=path.lstat();need(stat.S_ISREG(info.st_mode)and info.st_nlink==1 and info.st_size<=maximum,'bounded ordinary file')
    raw=path.read_bytes();need(len(raw)==info.st_size,'complete bounded file');return raw

def exclusive(path,raw):
    with path.open('xb')as stream:stream.write(raw);stream.flush();os.fsync(stream.fileno())

def stdin_request():
    os.set_blocking(0,False);raw=bytearray();deadline=time.monotonic()+30
    while time.monotonic()<deadline:
        try:part=os.read(0,min(65536,MAX_REQUEST+1-len(raw)))
        except BlockingIOError:time.sleep(.005);continue
        if not part:return bytes(raw)
        raw.extend(part);need(len(raw)<=MAX_REQUEST,'bounded stdin request')
    raise TimeoutError('request stdin deadline')

def bindings():
    need(os.name=='nt'and sys.version_info[:3]==(3,12,10)and sys.flags.isolated
        and sys.flags.no_site and not sys.flags.optimize and sys.dont_write_bytecode,'fixed isolated Windows CPython3.12.10 required')
    outer=strict(ordinary(HERE/'native-phase.json',2*1024**2))
    need(outer['native_fixed_startup_version'] in {'1.1','1.2','2.0','3.0','4.0'},'fixed startup version')
    raw=base64.b64decode(outer['config_base64'],validate=True)
    manifest=base64.b64decode(outer['manifest_base64'],validate=True)
    need(sha(raw)==outer['config_digest']and sha(manifest)==outer['manifest_digest'],'fixed config/manifest bytes')
    config=strict(raw);need(canon(config)==raw and canon(strict(manifest))==manifest,'canonical fixed configuration')
    need(((outer['native_fixed_startup_version']in {'2.0','3.0','4.0'} and config.get('native_launch_version')==outer['native_fixed_startup_version']) or (outer['native_fixed_startup_version']not in {'2.0','3.0','4.0'} and config.get('native_launch_version')not in {'2.0','3.0','4.0'})),'fixture startup and launch version must match')
    launcher=HERE/'launcher.py';need(Path(config['windows_launcher']).is_absolute()
        and Path(config['windows_launcher']).absolute()==launcher,'only sibling fixed launcher')
    need(sha(ordinary(launcher,2*1024**2))==config['artifact_graph']['launcher_digest'],'exact installed launcher')
    runtime=config['artifact_graph']['windows'];need(runtime['python_version']=='3.12.10'
        and sha(ordinary(Path(sys.executable),32*1024**2))==runtime['python_executable_digest'],'exact accepted Python executable')
    return launcher,outer

def exchange(process,frame):
    """Bound only the outer launcher pipes; no kill, resend or worker inference."""
    output=[bytearray(),bytearray()];discarded=[0,0];eof=[False,False]
    streams=[process.stdout,process.stderr];caps=[MAX_STDOUT,MAX_STDERR]
    primary=None;secondary=[];offset=0;closed=False;close_failed=False;deadline=time.monotonic()+180
    def error(value):return {'type':type(value).__name__,'message':str(value),
        'errno':getattr(value,'errno',None),'winerror':getattr(value,'winerror',None)}
    def close_input():
        nonlocal closed,close_failed,primary
        if closed:return
        closed=True
        try:process.stdin.close()
        except BaseException as value:
            close_failed=True
            if primary is None:primary=error(value)
            else:secondary.append(error(value))
    try:
        for stream in (process.stdin,*streams):os.set_blocking(stream.fileno(),False)
        while time.monotonic()<deadline:
            if not closed:
                try:offset+=os.write(process.stdin.fileno(),frame[offset:])
                except BlockingIOError:pass
                except OSError as value:primary=error(value);close_input()
                if not closed and offset==len(frame):close_input()
            for index,stream in enumerate(streams):
                if eof[index]:continue
                try:part=os.read(stream.fileno(),65536)
                except BlockingIOError:continue
                except OSError as value:
                    if value.errno==errno.EPIPE:part=b''
                    else:raise
                if not part:eof[index]=True;continue
                accepted=min(len(part),caps[index]-len(output[index]))
                output[index].extend(part[:accepted]);discarded[index]+=len(part)-accepted
            if process.poll()is not None and all(eof):break
            time.sleep(.005)
        else:raise TimeoutError('outer delivery deadline; known run remains unresolved')
    except BaseException as value:
        if primary is None:primary=error(value)
        else:secondary.append(error(value))
    finally:close_input()
    return bytes(output[0]),bytes(output[1]),{'primary':primary,'secondary':secondary,'discarded':discarded,
        'eof':eof,'complete':primary is None and not any(discarded)and all(eof),
        'initial_complete':offset==len(frame),'bytes_sent':offset,'stdin_close_failed':close_failed}

_INPUT_ACTIONS={'publish-input','publish-file'}


def reconciliation_role(action,value,outer):
    """Pure routing; accepted parent/factory still verifies every exact binding."""
    if action not in {'recover-publication','continue-version'}:
        return 'publish-input'if action in _INPUT_ACTIONS else'publish-bundle'if action=='publish-bundle'else'inspect-parent'if action=='inspect'else'parent'
    request=value['request'];manifest=strict(base64.b64decode(outer['manifest_base64'],validate=True))
    role=manifest['contract']['id']
    need(type(request['request_id'])is str and 0<len(request['request_id'])<=128
        and type(request['expected_intent_digest'])is str
        and re.fullmatch('sha256:[0-9a-f]{64}',request['expected_intent_digest'])is not None,'fixed recovery identity')
    if action=='recover-publication':
        need(request['native_bundle_recovery_request_version']=='1.0'
            and request['mode']in {'observe','commit_prepared'},'fixed recovery request')
        if role in {'file_create.v1','file_create.v2','bundle_create.v1'}:
            need(request['mode']=='observe','observe-only contract');return 'inspect-parent'
        need(role=='bundle_create.v2'and manifest['native_read_installation_version']=='1.9','closed Bundle2 recovery generation')
        return 'parent'
    need(role in {'publish_new_version.v1','publish_new_version.v2'}
        and request['native_version_continuation_request_version']=='1.0'
        and type(request['original_run_id'])is str and request['original_run_id']not in {'.','..',value['run_id']}
        and re.fullmatch('[A-Za-z0-9][A-Za-z0-9._-]{0,127}',request['original_run_id'])is not None
        and type(request['candidate_path'])is str and bool(request['candidate_path'])
        and type(request['input_paths'])is dict
        and all(type(k)is str and type(v)is str for k,v in request['input_paths'].items())
        and type(request['maximum_candidate_bytes'])is int and 0<request['maximum_candidate_bytes']<=1024**2,
        'fixed version continuation request')
    expected=request['expected_inputs']
    need(expected is None or type(expected)is dict and all(type(k)is str and type(v)is list and len(v)==2
        and type(v[0])is str and re.fullmatch('sha256:[0-9a-f]{64}',v[0])is not None
        and type(v[1])is int and v[1]>=0 for k,v in expected.items()),'fixed expected inputs')
    return 'parent'


def asserted_file_inspection(value,outer):
    manifest=strict(base64.b64decode(outer['manifest_base64'],validate=True))
    grants=manifest['root_grants']
    need(value['request']['root_binding']=='phase_result_root'
        and manifest['contract']['id'] in {'file_create.v1','file_create.v2'}
        and type(grants)is list and len(grants)==1 and grants[0]['root_binding']=='phase_result_root',
        'fixed installed file inspection root required')
    return {'run_id':value['run_id'],'request':{'operation':'inspect'}}


def input_publication_refusal(candidate,request,outer):
    fields={'native_input_publication_refusal_version','run_id','input_scope','role',
        'source_locator','request_id','target_locator','preparation_started','refusal','exit_code','retry_authorized'}
    need(candidate['source_locator']==request['source_locator'] and request['expected_current_digest']is None
        and candidate['preparation_started']is False and candidate['retry_authorized']is False
        and type(candidate['exit_code'])is int and candidate['exit_code']==10,'native input refusal binding')
    manifest=strict(base64.b64decode(outer['manifest_base64'],validate=True))
    contract=manifest['contract']['id']
    if candidate['native_input_publication_refusal_version']=='1.0':
        need(set(candidate)==fields|{'source_length','maximum_source_length','source_handles_closed'},
            'closed native file input refusal required')
        role,maximum={'file_create.v1':('File1',1024**2),'file_create.v2':('File2',2*1024**3)}.get(contract,(None,None))
        need(role is not None and candidate['role']==role and request['members']is None
            and type(candidate['maximum_source_length'])is int and candidate['maximum_source_length']==maximum
            and type(candidate['source_length'])is int and maximum<candidate['source_length']<2**63
            and candidate['source_handles_closed']is True,'native file input refusal binding')
        code='input_stage.member_bound'
    else:
        need(candidate['native_input_publication_refusal_version']=='1.1'
            and set(candidate)==fields|{'bound','source_finalization'},'closed native bundle input refusal required')
        role={'bundle_create.v1':'Bundle1','bundle_create.v2':'Bundle2'}.get(contract)
        members=request['members']; bound=candidate['bound']
        need(role is not None and candidate['role']==role and type(members)is list
            and all(type(member)is str for member in members)
            and type(bound)is dict and set(bound)=={'kind','observed','maximum'},'native bundle input refusal binding')
        kind=bound['kind']; observed=bound['observed']
        limits={'member_count':('bundle.member_count_limit',1024,'not_opened'),
            'member_depth':('bundle.reserved_or_deep_path',32,'not_opened'),
            'candidate_bytes':('bundle.request_too_large',1024**2,'not_opened'),
            'member_bytes':('input_stage.member_bound',2*1024**3,'closed'),
            'total_bytes':('input_stage.total_bound',4*1024**3,'closed'),
            'manifest_bytes':('bundle.metadata_limit',1024**2,'closed')}
        need(type(kind)is str and kind in limits,'native bundle input refusal limit')
        code,maximum,finalization=limits[kind]
        need(type(bound['maximum'])is int and bound['maximum']==maximum
            and type(observed)is int and maximum<observed<2**63
            and candidate['source_finalization']==finalization,'native bundle input refusal observation')
        if kind=='member_count':need(len(members)==observed,'native bundle input member count')
        if kind=='member_depth':need(any(path.count('/')+1==observed for path in members),'native bundle input member depth')
    expected_refusal={'stage3_command_result_version':'1.0','command':'execute','success':False,
        'run_id':None,'terminal_status':'rejected','execution_disposition':'not_executed',
        'mutation_attempted':False,'effect_plan_digest':None,'intent_digest':None,'receipt_digest':None,
        'target_verified':None,'blockers':[code],'error':code,'exit_code':10}
    need(canon(candidate['refusal'])==canon(expected_refusal),'native input refusal payload')


def partial_input_publication(candidate,request,outer,run_id):
    """Validate the closed 1.1 result over the already authenticated child."""
    fields={'native_input_publication_result_version','run_id','input_scope','role',
        'source_digest','source_length','request_id','target_locator','command_ack',
        'independent_inspection','exit_code','retry_authorized','status','inspection_required'}
    need(outer['native_fixed_startup_version']=='4.0' and set(candidate)==fields
        and candidate['native_input_publication_result_version']=='1.1'
        and candidate['run_id']==run_id and candidate['request_id']==request['request_id']
        and candidate['target_locator']==request['target_locator'] and candidate['input_scope']==request['input_scope']
        and candidate['status']=='committed_unverified' and candidate['inspection_required'] is True
        and candidate['retry_authorized'] is False and candidate['independent_inspection'] is None
        and type(candidate['exit_code']) is int and candidate['exit_code']==30,
        'native partial input result binding')
    manifest=strict(base64.b64decode(outer['manifest_base64'],validate=True))
    bounds={'file_create.v1':('File1',1,1024**2),'file_create.v2':('File2',0,2*1024**3),
        'publish_new_version.v1':('Version1',0,16*1024**2),'publish_new_version.v2':('Version2',0,512*1024),
        'bundle_create.v1':('Bundle1',1,1024**2),'bundle_create.v2':('Bundle2',1,1024**2)}
    role,minimum,maximum=bounds.get(manifest['contract']['id'],(None,0,0))
    def digest(value):
        return type(value) is str and re.fullmatch('sha256:[0-9a-f]{64}',value) is not None
    need(role is not None and candidate['role']==role and digest(candidate['source_digest'])
        and type(candidate['source_length']) is int and minimum<=candidate['source_length']<=maximum,
        'native partial input source binding')
    ack=candidate['command_ack']
    ack_fields={'stage3_command_result_version','command','success','run_id','terminal_status',
        'execution_disposition','mutation_attempted','effect_plan_digest','intent_digest','receipt_digest',
        'target_verified','blockers','error','exit_code'}
    need(type(ack) is dict and set(ack)==ack_fields and ack['stage3_command_result_version']=='1.0'
        and ack['command']=='execute' and ack['success'] is True and ack['run_id']==run_id
        and ack['terminal_status']=='succeeded_verified' and ack['execution_disposition'] in ('executed','reused_existing')
        and type(ack['mutation_attempted']) is bool
        and all(digest(ack[key]) for key in ('effect_plan_digest','intent_digest','receipt_digest'))
        and ack['target_verified'] is None and ack['blockers']==[] and ack['error'] is None
        and type(ack['exit_code']) is int and ack['exit_code']==0,
        'native partial input execute proof')


def staged_file_result(candidate,request,outer):
    fields={'publish_file_result_version','success','status','request_id','run_id','evidence_root','target_locator',
        'contract_binding','contract_digest','content_digest','content_length','receipt_digest','intent_digest',
        'effect_plan_digest','execution_disposition','mutation_attempted','target_verified','inspection_required',
        'error','exit_code'}
    manifest=strict(base64.b64decode(outer['manifest_base64'],validate=True))
    contract=manifest['contract']
    need(set(candidate)==fields and candidate['publish_file_result_version']=='1.0'
        and candidate['contract_binding']==contract['id']+'@'+contract['version']
        and candidate['contract_digest']==contract['package_digest']
        and candidate['evidence_root']==manifest['evidence_root'],'native file result installation correlation')
    status=candidate['status']
    exit_codes={'verified':0,'rejected_before_write':10,'committed_unverified':30,'indeterminate':40}
    need(type(status)is str and status in exit_codes and candidate['exit_code']==exit_codes[status]
        and candidate['success'] is (status=='verified') and candidate['target_verified'] is (status=='verified')
        and type(candidate['inspection_required'])is bool
        and (candidate['mutation_attempted'] is None or type(candidate['mutation_attempted'])is bool),
        'native file result status correlation')
    def digest(value):
        return type(value)is str and re.fullmatch('sha256:[0-9a-f]{64}',value) is not None
    if status=='verified':
        version={'file_create.v1':'1.0','file_create.v2':'2.0'}.get(contract['id'])
        limit=1024**2 if version=='1.0' else 2*1024**3
        need(version is not None and request['publication_version']==version
            and request['root_binding']=='phase_result_root' and candidate['error']is None
            and candidate['inspection_required']is False and candidate['mutation_attempted']is not None
            and candidate['execution_disposition']in {'executed','reused_existing'}
            and digest(candidate['content_digest']) and candidate['content_digest']==request['expected_digest']
            and type(candidate['content_length'])is int and 0<=candidate['content_length']<=limit
            and all(digest(candidate[field]) for field in ('receipt_digest','intent_digest','effect_plan_digest')),
            'native verified file result proof')
    if status=='rejected_before_write':
        # A staged File1 occupancy rejection can carry the finalized Core
        # receipt. Delivery correlates it; independent inspect verifies proof.
        receipt=candidate['receipt_digest']
        occupied_before_intent=(contract['id']=='file_create.v1'
            and request['publication_version']=='1.0' and request['root_binding']=='phase_result_root'
            and candidate['error']=='target.destination_exists'
            and candidate['execution_disposition']=='not_executed'
            and candidate['intent_digest'] is None and candidate['effect_plan_digest'] is None
            and candidate['inspection_required'] is False and digest(receipt)
            and digest(candidate['content_digest']) and candidate['content_digest']==request['expected_digest']
            and type(candidate['content_length'])is int and 0<=candidate['content_length']<=1024**2)
        need(candidate['mutation_attempted'] is False and (receipt is None or occupied_before_intent)
            and type(candidate['error'])is str and bool(candidate['error']),'native file refusal proof')
    if status in {'committed_unverified','indeterminate'}:
        need(candidate['inspection_required']is True,'native file uncertainty proof')


def input_failure_line(raw=b'',*,timeout=False):
    if 0<len(raw)<=64:
        try:
            value=strict(raw)
            if type(value)is dict and canon(value)+b'\n'==raw:
                if (set(value)=={'phase','error_class'}
                        and value['phase'] in ('stage','execute','inspect','delivery')
                        and value['error_class'] in ('timeout','error')):
                    return raw
                if (set(value)=={'phase','error_class','reason'} and value['phase']=='execute'
                        and ((value['error_class']=='timeout' and value['reason'] in (
                            'deadline','rx_empty','rx_bytes','rx_first','rx_fdata','rx_next','rx_ndata','tx','tx_obs'))
                            or (value['error_class'],value['reason'])==('error','eof'))):
                    return raw
        except (ValueError,RuntimeError):
            pass
    return canon({'phase':'delivery','error_class':'timeout' if timeout else 'error'})+b'\n'


def diagnostic_run_id(report):
    run_id=report['run_id']
    return run_id if re.fullmatch('[A-Za-z0-9][A-Za-z0-9._-]{0,127}',run_id) is not None else None


def bounded_delivery(report):
    """Preserve normal delivery bytes or a bounded UNKNOWN with actual observations."""
    try:
        raw=canon(report)
        if len(raw)<=MAX_DELIVERY:
            return raw,None
        reason='DELIVERY_REPORT_TOO_LARGE'
        encoding='UTF8_JSON'
    except UnicodeEncodeError:
        # Preserve an exact escaped representation of otherwise unencodable diagnostics.
        raw=json.dumps(report,ensure_ascii=True,sort_keys=True,separators=(',',':'),allow_nan=False).encode('ascii')
        reason='DELIVERY_REPORT_UNENCODABLE'
        encoding='ASCII_JSON'
    prefix=raw[:DELIVERY_DIAGNOSTIC_PREFIX]
    compact={name:report[name] for name in ('operation','request_sha256','process_exit','outer_owner_finalization',
        'native_worker_quiescence_proven','retry_authorized','manifest_digest','scope','stdout_bytes','stderr_bytes',
        'stdout_sha256','stderr_sha256')}
    if 'pid'in report:
        compact['pid']=report['pid']
    capture=report['capture']
    compact.update(run_id=diagnostic_run_id(report),child_delivery='UNKNOWN',
        capture=None if capture is None else {name:capture[name] for name in ('discarded','eof','complete',
            'initial_complete','bytes_sent','stdin_close_failed')},
        error={'type':reason,'message':'Delivery report unavailable. Inspect the known run through its fixed reader.'},
        delivery_report_diagnostic={'encoding':encoding,'bytes':len(raw),'sha256':sha(raw),
            'prefix_bytes':len(prefix),'prefix_base64':base64.b64encode(prefix).decode('ascii')})
    body=canon(compact)
    need(len(body)<=MAX_DELIVERY,'bounded compact delivery report')
    return body,reason


def main():
    need(len(sys.argv)==4 and sys.argv[1]in _INPUT_ACTIONS|{'execute','inspect','publish-bundle','recover-publication','continue-version'},'usage: cli.py execute|inspect|publish-bundle|publish-input|publish-file|recover-publication|continue-version REQUEST_JSON|- NEW_CAPTURE_DIR')
    action,source,destination=sys.argv[1:];launcher,outer=bindings()
    raw=stdin_request()if source=='-'else ordinary(Path(source),MAX_REQUEST)
    value=strict(raw);need(type(value)is dict and set(value)=={'run_id','request'}
        and type(value['run_id'])is str and type(value['request'])is dict,'existing request envelope required')
    request=value['request'];need(request.get('operation')==action.replace('-','_'),'command/action mismatch')
    expected=({'operation','native_version_continuation_request_version','original_run_id','request_id','expected_intent_digest','candidate_path','input_paths','expected_inputs','maximum_candidate_bytes'}if action=='continue-version'else{'operation','native_bundle_recovery_request_version','request_id','expected_intent_digest','mode'}if action=='recover-publication'else{'operation','input_scope','source_locator','target_locator','request_id','members','expected_current_digest'}if action=='publish-input'else{'operation','source_locator','target_locator','request_id','members'}if action=='publish-bundle'else
        {'operation','input_scope','source_locator','target_locator','request_id','publication_version','expected_digest',
            'root_binding'}if action=='publish-file'else{'operation'}if action=='inspect'else
        {'operation','candidate_path','input_paths','expected_inputs','maximum_candidate_bytes'})
    asserted_inspect=action=='inspect' and set(request)=={'operation','root_binding'}
    need(asserted_inspect or set(request)==expected,'closed fixed CLI request required')
    child_role=reconciliation_role(action,value,outer)
    body=canon(value);need(0<len(body)<=MAX_REQUEST,'bounded canonical request')
    # Preserve the caller assertion in capture. The fixed reader still accepts
    # only its original unary wire and independently authenticates its grant.
    wire_body=canon(asserted_file_inspection(value,outer)) if asserted_inspect else body
    requested_capture=Path(destination).absolute()
    need(requested_capture.name not in ('','.','..'),'ordinary new capture leaf required')
    ordinary_parent=requested_capture.parent
    for part in (*reversed(ordinary_parent.parents),ordinary_parent):
        info=part.lstat();need(stat.S_ISDIR(info.st_mode)and not stat.S_ISLNK(info.st_mode)
            and not getattr(info,'st_file_attributes',0)&0x400,'ordinary existing capture parent required')
    capture_dir=ordinary_parent.resolve(strict=True)/requested_capture.name
    need(not capture_dir.is_relative_to(HERE.resolve(strict=True)),'capture directory must be outside installation directory')
    capture_dir.mkdir();exclusive(capture_dir/'request.json',body)
    frame=f'{len(wire_body):08x}\n'.encode()+wire_body+b'\n'
    out=err=b'';process=None;result=None
    report={'run_id':value['run_id'],'operation':action,'request_sha256':sha(body),'child_delivery':'UNKNOWN',
        'capture':None,'process_exit':None,'outer_owner_finalization':'UNKNOWN','error':None,
        'native_worker_quiescence_proven':False,'retry_authorized':False,'manifest_digest':outer['manifest_digest'],
        'scope':'operational outer delivery only; not receipt/evidence, worker proof or caller ACK'}
    try:
        process=subprocess.Popen([sys.executable,'-I','-S','-B','-u',str(launcher),
            child_role],cwd=str(HERE),
            env={'SYSTEMROOT':os.environ['SYSTEMROOT'],'WINDIR':os.environ['WINDIR'],'PYTHONDONTWRITEBYTECODE':'1'},
            stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,bufsize=0,
            creationflags=subprocess.CREATE_NO_WINDOW)
        _PENDING_DELIVERY_OWNERS.append(process);report['pid']=process.pid
        out,err,capture=exchange(process,frame);report['capture']=capture;report['process_exit']=process.poll()
        if all(capture['eof'])and type(process.poll())is int:
            errors=[]
            for stream in (process.stdin,process.stdout,process.stderr):
                try:
                    if not stream.closed:stream.close()
                except BaseException as error:errors.append(type(error).__name__)
            try:
                if not process._handle.closed:process._handle.Close()
            except BaseException as error:errors.append(type(error).__name__)
            if not errors and not capture['stdin_close_failed']and all(stream.closed for stream in (process.stdin,process.stdout,process.stderr))and process._handle.closed:report['outer_owner_finalization']='closed'
            report['outer_close_errors']=errors
        need(capture['complete']is True and capture['initial_complete']is True
            and report['outer_owner_finalization']=='closed','outer capture incomplete; inspect known run')
        need(re.fullmatch(b'[0-9a-f]{8}\n',out[:9])is not None and out[-1:]==b'\n'
            and len(out)==int(out[:8],16)+10,'incomplete native delivery frame')
        native=strict(out[9:-1]);need(canon(native)==out[9:-1]and type(native)is dict,
            'canonical delivery object required')
        if action in _INPUT_ACTIONS:
            need(set(native)=={'protocol','version','run_id','installation_digest','result','exit_code'}
                and native['protocol']=='phase.native.input.publication'and native['version']=='1.0'
                and native['run_id']==value['run_id']and native['installation_digest']==outer['manifest_digest'],
                'native input publication envelope correlation')
            candidate=native['result']
            need(type(candidate)is dict
                and candidate.get('run_id')==value['run_id']and candidate.get('request_id')==request['request_id']
                and candidate.get('target_locator')==request['target_locator'],'native input caller correlation')
            if action=='publish-file':
                staged_file_result(candidate,request,outer)
            else:
                need(candidate.get('input_scope')==request['input_scope'],'native input caller correlation')
                if 'native_input_publication_refusal_version'in candidate:
                    input_publication_refusal(candidate,request,outer)
                elif candidate.get('native_input_publication_result_version')=='1.1':
                    partial_input_publication(candidate,request,outer,value['run_id'])
                else:
                    need(candidate.get('native_input_publication_result_version')=='1.0'
                        and 'status' not in candidate and 'inspection_required' not in candidate,'native input result version')
        elif action=='publish-bundle':
            need(set(native)=={'protocol','version','run_id','installation_digest','result','exit_code'}
                and native['protocol']=='phase.native.publication'and native['version']=='1.0'
                and native['run_id']==value['run_id']and native['installation_digest']==outer['manifest_digest'],
                'native publication envelope correlation')
            candidate=native['result']
            need(type(candidate)is dict and candidate.get('publish_bundle_result_version')=='1.1'
                and candidate.get('run_id')==value['run_id']and candidate.get('request_id')==request['request_id']
                and candidate.get('target_locator')==request['target_locator'],'native publication caller correlation')
        elif action=='recover-publication':
            need(set(native)=={'protocol','version','channel_id','run_id','result','exit_code'}
                and native['protocol']=='phase.native.command'and native['version']==('1.4'if child_role=='inspect-parent'else'1.2')
                and native['run_id']==value['run_id']and type(native['channel_id'])is str
                and re.fullmatch('[0-9a-f]{32}',native['channel_id'])is not None,'native recovery envelope correlation')
            candidate=native['result']
            need(type(candidate)is dict and candidate.get('recovery_result_version')=='1.2'
                and candidate.get('run_id')==value['run_id']and candidate.get('request_id')==request['request_id']
                and candidate.get('intent_digest')in(None,request['expected_intent_digest'])
                and(candidate.get('recovery_mutation_attempted')in(False,None)if child_role=='inspect-parent'else True),
                'native recovery caller correlation')
        else:
            need(set(native)=={'protocol','version','channel_id','run_id','result','exit_code'}
                and native['protocol']=='phase.native.command'and native['version']=='1.0'
                and native['run_id']==value['run_id']and type(native['channel_id'])is str
                and re.fullmatch('[0-9a-f]{32}',native['channel_id'])is not None,'native envelope correlation')
            candidate=native['result'];need(type(candidate)is dict and candidate.get('command')==('execute'if action=='continue-version'else action)
                and candidate.get('run_id')in (None,value['run_id']),'native command correlation')
        need(type(native['exit_code'])is int and type(candidate.get('exit_code'))is int
            and 0<=native['exit_code']<=255 and native['exit_code']==candidate['exit_code']==report['process_exit'],
            'native command/exit correlation')
        # The trusted owner validated the result before releasing its call gate.
        # This outer transport preserves nullable/negative/uncertain fields.
        result=candidate;report['child_delivery']=('COMPLETE_NATIVE_PUBLICATION_FRAME'if action in {'publish-bundle','publish-file'}
            else'COMPLETE_NATIVE_COMMAND_FRAME')
        if action=='publish-input'and 'native_input_publication_refusal_version'in candidate:
            report['child_delivery']='COMPLETE_NATIVE_INPUT_REFUSAL_FRAME'
        elif action=='publish-input' and candidate.get('native_input_publication_result_version')=='1.1':
            report['child_delivery']='COMPLETE_NATIVE_INPUT_PARTIAL_FRAME'
    except BaseException as error:report['error']={'type':type(error).__name__,'message':str(error)}
    report.update(stdout_bytes=len(out),stderr_bytes=len(err),stdout_sha256=sha(out),stderr_sha256=sha(err))
    try:
        exclusive(capture_dir/'stdout.bin',out);exclusive(capture_dir/'stderr.bin',err)
        delivery,delivery_error=bounded_delivery(report)
        exclusive(capture_dir/'delivery.json',delivery)
    except BaseException as error:
        if action in _INPUT_ACTIONS:
            sys.stderr.buffer.write(input_failure_line(timeout=isinstance(error,TimeoutError)))
            sys.stderr.buffer.flush();return 50
        sys.stderr.buffer.write(canon({'run_id':diagnostic_run_id(report),'capture_error':type(error).__name__,
            'stdout_base64':base64.b64encode(out).decode(),'stderr_base64':base64.b64encode(err).decode(),
            'retry_authorized':False,'message':'Delivery diagnostics incomplete; inspect known run.'})+b'\n')
        sys.stderr.buffer.flush();return 50
    if delivery_error is not None:
        note=(input_failure_line() if action in _INPUT_ACTIONS else canon({'run_id':diagnostic_run_id(report),
            'request_sha256':report['request_sha256'],'child_delivery':'UNKNOWN','delivery_error':delivery_error,
            'retry_authorized':False})+b'\n')
        sys.stderr.buffer.write(note);sys.stderr.buffer.flush();return 50
    if err and action not in _INPUT_ACTIONS:sys.stderr.buffer.write(err);sys.stderr.buffer.flush()
    if result is None:
        if action in _INPUT_ACTIONS:
            capture=report['capture'] or {}
            timeout=any(type(record)is dict and record.get('type') in ('TimeoutError','TimeoutExpired')
                for record in (report['error'],capture.get('primary')))
            child_diagnostic=err if (report['process_exit']==50 and report['outer_owner_finalization']=='closed'
                and capture.get('complete')is True and capture.get('initial_complete')is True) else b''
            sys.stderr.buffer.write(input_failure_line(child_diagnostic,timeout=timeout))
            sys.stderr.buffer.flush();return 50
        sys.stderr.buffer.write(canon({'run_id':value['run_id'],'child_delivery':'UNKNOWN','retry_authorized':False,
            'captures':str(capture_dir),'message':'No synthetic command result. Inspect the known run through its fixed reader.'})+b'\n')
        sys.stderr.buffer.flush();return 50
    sys.stdout.buffer.write(canon(result)+b'\n');sys.stdout.buffer.flush();return result['exit_code']

if __name__=='__main__':
    try:status=main()
    except BaseException as error:
        try:
            if len(sys.argv)>1 and sys.argv[1] in _INPUT_ACTIONS:
                os.write(2,input_failure_line(timeout=isinstance(error,TimeoutError)))
            else:os.write(2,canon({'error':type(error).__name__,'message':str(error),'retry_authorized':False})+b'\n')
        except BaseException:pass
        status=50
    raise SystemExit(status)
