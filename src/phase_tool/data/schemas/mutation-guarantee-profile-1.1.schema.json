{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phase-tool.local/schemas/mutation-guarantee-profile-1.1.schema.json",
  "title": "Phase Mutation Guarantee Profile v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptor_version",
    "id",
    "version",
    "classification",
    "vocabulary",
    "provided_guarantees",
    "storage_scope",
    "limitations",
    "implementation",
    "descriptor_digest_binding",
    "conformance"
  ],
  "properties": {
    "descriptor_version": {
      "const": "1.1"
    },
    "id": {
      "type": "string",
      "pattern": "^phase\\.[a-z0-9._-]+\\.authority\\.v[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "classification": {
      "enum": [
        "qualification_candidate",
        "production"
      ]
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "descriptor_digest"
      ],
      "properties": {
        "id": {
          "const": "phase.mutation-guarantees"
        },
        "version": {
          "const": "1.0.0"
        },
        "descriptor_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "provided_guarantees": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      }
    },
    "storage_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem",
        "mount_boundary",
        "cooperating_processes_only"
      ],
      "properties": {
        "filesystem": {
          "type": "string",
          "minLength": 1
        },
        "mount_boundary": {
          "type": "string",
          "minLength": 1
        },
        "cooperating_processes_only": {
          "type": "boolean"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "artifact",
        "artifact_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^phase\\.[a-z0-9._-]+\\.authority$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "artifact": {
          "type": "string",
          "pattern": "^phase_tool/mutation/ntfs/[a-z][a-z0-9_]*\\.py$"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "descriptor_digest_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "registry_field"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "raw_artifact_bytes"
        },
        "registry_field": {
          "const": "artifact_digest"
        }
      }
    },
    "conformance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "guarantee",
          "test_id"
        ],
        "properties": {
          "guarantee": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "test_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "qualification_candidate"
          }
        }
      },
      "then": {
        "properties": {
          "provided_guarantees": {
            "const": []
          },
          "conformance": {
            "const": []
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "const": "production"
          }
        }
      },
      "then": {
        "properties": {
          "provided_guarantees": {
            "minItems": 1
          },
          "conformance": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
