{
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "exactBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "package_digest": {
          "$ref": "#/$defs/digest"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "id",
        "version",
        "package_digest"
      ],
      "type": "object"
    },
    "identifier": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "implementation_authorityBinding": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "profile": {
              "$ref": "#/$defs/implementation_profileBinding"
            },
            "provider": {
              "$ref": "#/$defs/implementation_providerBinding"
            },
            "usage": {
              "const": "provider_backed"
            }
          }
        },
        {
          "properties": {
            "profile": {
              "type": "null"
            },
            "provider": {
              "type": "null"
            },
            "usage": {
              "const": "mechanism_managed"
            }
          }
        }
      ],
      "properties": {
        "profile": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/implementation_profileBinding"
            }
          ]
        },
        "provider": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/implementation_providerBinding"
            }
          ]
        },
        "usage": {
          "enum": [
            "provider_backed",
            "mechanism_managed"
          ]
        }
      },
      "required": [
        "usage",
        "profile",
        "provider"
      ],
      "type": "object"
    },
    "implementation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "implementation_exactBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/implementation_identifier"
        },
        "package_digest": {
          "$ref": "#/$defs/implementation_digest"
        },
        "version": {
          "$ref": "#/$defs/implementation_semver"
        }
      },
      "required": [
        "id",
        "version",
        "package_digest"
      ],
      "type": "object"
    },
    "implementation_identifier": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "type": "string"
    },
    "implementation_profileBinding": {
      "additionalProperties": false,
      "properties": {
        "descriptor_digest": {
          "$ref": "#/$defs/implementation_digest"
        },
        "id": {
          "$ref": "#/$defs/implementation_identifier"
        },
        "version": {
          "$ref": "#/$defs/implementation_semver"
        }
      },
      "required": [
        "id",
        "version",
        "descriptor_digest"
      ],
      "type": "object"
    },
    "implementation_providerBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/implementation_digest"
        },
        "id": {
          "$ref": "#/$defs/implementation_identifier"
        },
        "version": {
          "$ref": "#/$defs/implementation_semver"
        }
      },
      "required": [
        "id",
        "version",
        "artifact_digest"
      ],
      "type": "object"
    },
    "implementation_semver": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "nativeBinding": {
      "additionalProperties": false,
      "properties": {
        "composition": {
          "additionalProperties": false,
          "properties": {
            "artifact_graph_digest": {
              "$ref": "#/$defs/digest"
            },
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "version": {
              "$ref": "#/$defs/semver"
            }
          },
          "required": [
            "id",
            "version",
            "artifact_graph_digest"
          ],
          "type": "object"
        },
        "evidence_identity": {
          "additionalProperties": false,
          "properties": {
            "device": {
              "minimum": 0,
              "type": "integer"
            },
            "inode": {
              "minimum": 1,
              "type": "integer"
            },
            "stable_id": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "stable_id",
            "device",
            "inode"
          ],
          "type": "object"
        },
        "installation": {
          "additionalProperties": false,
          "properties": {
            "descriptor_digest": {
              "$ref": "#/$defs/digest"
            },
            "id": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "id",
            "descriptor_digest"
          ],
          "type": "object"
        },
        "native_binding_version": {
          "const": "1.0"
        },
        "operation_nonce": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        }
      },
      "required": [
        "native_binding_version",
        "installation",
        "composition",
        "evidence_identity",
        "operation_nonce"
      ],
      "type": "object"
    },
    "nativeRootGrant": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "not": {
              "pattern": "^(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])(?:\\.|$)"
            },
            "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]*[A-Za-z0-9_])?$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "device": {
          "pattern": "^\\\\Device\\\\HarddiskVolume[0-9]+$",
          "type": "string"
        },
        "native_identity": {
          "additionalProperties": false,
          "properties": {
            "file_id": {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            "volume_serial": {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "volume_serial",
            "file_id"
          ],
          "type": "object"
        },
        "root_binding": {
          "$ref": "#/$defs/identifier"
        },
        "volume_guid": {
          "pattern": "^\\\\\\\\\\?\\\\volume\\{[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\}\\\\$",
          "type": "string"
        },
        "volume_serial32": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "root_binding",
        "device",
        "volume_guid",
        "volume_serial32",
        "components",
        "native_identity"
      ],
      "type": "object"
    },
    "runId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "type": "string"
    },
    "semver": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    }
  },
  "$id": "https://phase-tool.local/schemas/phase-intent-1.2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "input_mode": {
          "enum": [
            "structured_json",
            "utf8_bytes",
            "binary_bundle"
          ]
        },
        "length": {
          "minimum": 0,
          "type": "integer"
        },
        "storage": {
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "attachment"
                  }
                }
              },
              "then": {
                "properties": {
                  "attachment_digest": {
                    "type": "string"
                  },
                  "value": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "inline"
                  }
                }
              },
              "then": {
                "properties": {
                  "attachment_digest": {
                    "type": "null"
                  }
                }
              }
            }
          ],
          "properties": {
            "attachment_digest": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/digest"
                }
              ]
            },
            "mode": {
              "enum": [
                "inline",
                "attachment"
              ]
            },
            "value": {}
          },
          "required": [
            "mode",
            "value",
            "attachment_digest"
          ],
          "type": "object"
        }
      },
      "required": [
        "input_mode",
        "digest",
        "length",
        "storage"
      ],
      "type": "object"
    },
    "contract": {
      "$ref": "#/$defs/exactBinding"
    },
    "core": {
      "$ref": "#/$defs/exactBinding"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "effect_plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "content_blob_digests": {
          "items": {
            "$ref": "#/$defs/digest"
          },
          "type": "array",
          "uniqueItems": true
        },
        "effect_plan_attachment_digest": {
          "$ref": "#/$defs/digest"
        },
        "pre_validator_results_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "effect_plan_attachment_digest",
        "content_blob_digests",
        "pre_validator_results_digest"
      ],
      "type": "object"
    },
    "execution_requested": {
      "type": "boolean"
    },
    "idempotency": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          ]
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "root_identities": {
          "items": {
            "$ref": "#/$defs/nativeRootGrant"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "root_identity_digest": {
          "$ref": "#/$defs/digest"
        },
        "scope_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "key",
        "scope_digest",
        "request_digest",
        "root_identity_digest",
        "root_identities"
      ],
      "type": "object"
    },
    "implementation_binding": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/implementation_authorityBinding"
        },
        "effect_plan_digest": {
          "$ref": "#/$defs/implementation_digest"
        },
        "mechanism": {
          "$ref": "#/$defs/implementation_exactBinding"
        }
      },
      "required": [
        "authority",
        "mechanism",
        "effect_plan_digest"
      ],
      "type": "object"
    },
    "inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "binding_id": {
            "$ref": "#/$defs/identifier"
          },
          "blob_digest": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/digest"
              }
            ]
          },
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "freeze_strategy": {
            "enum": [
              "copy_and_hash",
              "manifest_and_hash",
              "lock_snapshot_revalidate",
              "value_snapshot"
            ]
          },
          "frozen_at": {
            "format": "date-time",
            "type": "string"
          },
          "manifest_digest": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/digest"
              }
            ]
          },
          "provenance_ref": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "maxLength": 2048,
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "revalidation_token": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "binding_id",
          "freeze_strategy",
          "digest",
          "manifest_digest",
          "blob_digest",
          "provenance_ref",
          "frozen_at",
          "revalidation_token"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "native_binding": {
      "$ref": "#/$defs/nativeBinding"
    },
    "operation": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "enum": [
            "create",
            "append",
            "copy",
            "correction",
            "publish_new_version"
          ]
        },
        "mechanism": {
          "$ref": "#/$defs/exactBinding"
        }
      },
      "required": [
        "intent",
        "mechanism"
      ],
      "type": "object"
    },
    "phase_intent_version": {
      "const": "1.2"
    },
    "registry_snapshot_digest": {
      "$ref": "#/$defs/digest"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "status": {
      "const": "intent_recorded"
    },
    "write_scope_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "required": [
    "phase_intent_version",
    "run_id",
    "created_at",
    "core",
    "registry_snapshot_digest",
    "contract",
    "candidate",
    "inputs",
    "write_scope_digest",
    "operation",
    "idempotency",
    "effect_plan_digest",
    "execution_requested",
    "evidence",
    "status",
    "native_binding",
    "implementation_binding"
  ],
  "title": "Phase Intent v1.2: native binding (schema only, no admission)",
  "type": "object"
}
